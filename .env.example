# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
REDIS_URL=redis://localhost:6379/0

# Absolute safety defaults - see docs/spec master doc section A.
LIVE_TRADING=false
TRADING_MODE=PAPER_APPROVAL
LIVE_AUTO=false

# KIS (Korea Investment Securities) - see docs/KIS_SETUP.md
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_REST_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WS_URL=wss://ops.koreainvestment.com:21000
# P29 order placement safety switch - see docs/KIS_SETUP.md's "Order
# placement" section. true = 모의투자(paper) tr_ids, false = real-money
# tr_ids. Independent from LIVE_TRADING above; both must be deliberately
# changed from their safe defaults for a real order to ever be possible.
KIS_PAPER_TRADING=true

# Toss Securities Open API - see docs/TOSS_SETUP.md
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_REST_BASE_URL=https://openapi.tossinvest.com

# Upbit - see docs/UPBIT_NOTES.md. Only needed for P15 order placement;
# market data (P7/P9) is public and needs no key.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Kakao Login + notification - see docs/KAKAO_SETUP.md
# KAKAO_CLIENT_ID is the app's "REST API key" in Kakao Developers' own
# terminology - used as OAuth2 client_id here for consistency with KIS/Toss.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# Only for test_kakao_integration.py's real-connection test - a refresh
# token obtained once by hand through the real Kakao Login flow. Never read
# by the running application itself.
KAKAO_TEST_REFRESH_TOKEN=

# Secure approval UX (P13) - see docs/MASTER_SPEC.md sections C-E
APPROVAL_TOKEN_TTL_SECONDS=180
# PBKDF2 hash of the app PIN as "<salt_hex>$<hash_hex>" - generate with
# app.approval.pin.hash_pin("your-pin"). Never the plaintext PIN.
APP_PIN_HASH=
APPROVAL_BASE_URL=http://localhost:5173

# Android app (PWA -> TWA, P43) - see docs/ANDROID_APP.md. The public
# origin the frontend is reached at once you set one up (e.g. a Cloudflare
# Tunnel hostname like https://radar.example.com) - added to the backend's
# CORS allowlist alongside the always-on localhost dev origins. Leave blank
# until you actually have one; comma-separate for more than one.
CORS_EXTRA_ORIGINS=
# Only needed to run `docker compose --profile android up -d` (the
# optional `cloudflared` service) - a tunnel token from the Cloudflare
# Zero Trust dashboard, see docs/ANDROID_APP.md.
CLOUDFLARE_TUNNEL_TOKEN=
# Baked into the frontend's built JS at image build time (Vite env vars
# are not read at container start) - the backend's public origin, e.g.
# https://api.radar.example.com. Leave at the default for local dev;
# rebuild the frontend image (`docker compose build frontend`) after
# changing this.
VITE_API_BASE_URL=http://localhost:8000
