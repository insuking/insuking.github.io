# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
REDIS_URL=redis://localhost:6379/0

# Absolute safety defaults - see docs/spec master doc section A.
LIVE_TRADING=false
TRADING_MODE=PAPER_APPROVAL
LIVE_AUTO=false

# KIS (Korea Investment Securities) - see docs/KAKAO_SETUP.md siblings for setup guides
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# Toss
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Upbit
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Kakao
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
